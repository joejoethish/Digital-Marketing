# Copy to .env.local and fill in.

# ── Contact details (public — shown in the header & contact page) ──
# Inlined at build time: restart `npm run dev` / rebuild after changing.
# Leave WhatsApp / Instagram / phone empty to hide those buttons.
# WhatsApp: digits only with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Full Instagram profile URL, e.g. https://instagram.com/deeyora
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@deeyora.com
# Display format, e.g. +91 98765 43210
NEXT_PUBLIC_CONTACT_PHONE=

# ── Contact form email (server-only secrets) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
